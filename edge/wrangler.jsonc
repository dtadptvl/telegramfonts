{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "telegramfonts-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "telegramfonts-d1",
      "database_id": "4ab4ab25-37cc-4044-acc9-66fc98b9f831",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "FULFILLMENT_QUEUE",
        "queue": "telegramfonts-fulfillment"
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "ARTIFACTS_BUCKET",
      "bucket_name": "telegramfonts-artifacts"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "vars": {
    "BASE_URL": "https://telegramfonts-edge.dienluanphien98.workers.dev",
    // T-FAST30-A23-FIX F4: job-age backstop (ms). Documented default = 2100000
    // (35 min): the 30-min FAST_30 job wall plus a 5-min operational margin.
    // Heartbeat extension is refused and the exhausted-job finalizer gains an
    // age-based candidate clause once the current lease age exceeds this cap.
    "MAX_JOB_AGE_MS": "2100000",
    // T-FAST-ATLAS-A23-ORIGINAL-RELEASE-01: temporary pre-payment lock until live Vietnamese AI smoke passes (E-00027).
    // Flip to 'true' only after the VN live smoke succeeds.
    "VIETNAMESE_ORDERING_ENABLED": "false"
  }
}
