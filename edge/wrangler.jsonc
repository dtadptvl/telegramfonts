{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "telegramfonts-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "telegramfonts-d1",
      "database_id": "4ab4ab25-37cc-4044-acc9-66fc98b9f831",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "FULFILLMENT_QUEUE",
        "queue": "telegramfonts-fulfillment"
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "ARTIFACTS_BUCKET",
      "bucket_name": "telegramfonts-artifacts"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "vars": {
    "BASE_URL": "https://telegramfonts-edge.dienluanphien98.workers.dev",
    "BANK_ID": "970422",
    "BANK_ACCOUNT_NUMBER": "0123456789",
    "BANK_ACCOUNT_NAME": "TELEGRAMFONTS"
  }
}
