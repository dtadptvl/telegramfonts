{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex Orchestra Executor event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "ref",
    "head",
    "summary",
    "changed_files",
    "evidence",
    "blocker"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "DONE",
        "UPDATED",
        "NO_CHANGE",
        "BLOCKED",
        "READY_HUMAN_AUTH",
        "SECURITY_BLOCKED"
      ]
    },
    "ref": {
      "type": "string",
      "pattern": "^(SELF|(issue|review|pr):[A-Za-z0-9._-]+)$"
    },
    "head": {
      "type": ["string", "null"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "changed_files": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "blocker": {
      "type": ["string", "null"]
    }
  }
}
